{
  "lineWidth": 100,
  "markdown": {
    "textWrap": "maintain"
  },
  "toml": {
    "indentWidth": 4
  },
  "includes": [
    "**/*.{md,toml}"
  ],
  "excludes": [
    "**/target",
    "**/Cargo.lock",
    "**/.agents/**",
    "**/.gemini/**",
    "**/.system_generated/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.17.8.wasm",
    "https://plugins.dprint.dev/toml-0.6.4.wasm"
  ]
}
